# Copy to .env and fill in. Only the provider key for your model is required.
OPENAI_API_KEY=

# Primary model (any litellm model string) and fallbacks tried on model/provider errors.
LLM_MODEL=openai/gpt-6-luna
FALLBACK_MODELS=openai/gpt-4.1-mini
# Used when the prompt exceeds the primary model's context window.
CONTEXT_FALLBACK_MODEL=openai/gpt-4.1-mini

# Optional tuning
# TIMEZONE=Asia/Kolkata
# MAX_STEPS=8
# MAX_TOOL_RETRIES=2
# LLM_STREAMING=true
# LOG_DIR=logs
# LOG_CONTENT=true          # false: logs keep structure/latency but no message text or tool args
# MOCK_PERSIST=true         # write calendar changes back to events.csv (false: in-memory only)
# MOCK_DATA_DIR=mocks/data  # folder with events.csv, contacts.csv, interactions.csv
# MOCK_FAILURE_RATE=0.0     # e.g. 0.2 makes mocked tools fail randomly (seeded by MOCK_SEED)

# Optional LangSmith tracing (only active when the key is set)
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=presolv-agent
